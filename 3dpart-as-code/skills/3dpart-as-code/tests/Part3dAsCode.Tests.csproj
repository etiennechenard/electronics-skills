<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The templates are plain include-files; compile them here directly so
       these tests exercise exactly the code the project scripts #:include.
       Never a ..\templates\*.cs glob: it would also compile the entry
       files' top-level statements (build.cs, check.cs, smoke.cs...). -->
  <ItemGroup>
    <Compile Include="..\templates\partmodel.cs" Link="partmodel.cs" />
    <Compile Include="..\templates\part.cs" Link="part.cs" />
    <Compile Include="..\templates\mech.cs" Link="mech.cs" />
    <Compile Include="..\templates\stl.cs" Link="stl.cs" />
    <Compile Include="..\templates\checks.cs" Link="checks.cs" />
    <Compile Include="..\templates\raster.cs" Link="raster.cs" />
    <Compile Include="..\templates\partedit.cs" Link="partedit.cs" />
    <Compile Include="..\templates\paramsheet.cs" Link="paramsheet.cs" />
  </ItemGroup>

  <!-- In a project, example/ keeps the worked example (part.cs, bracket.py)
       as the pipeline test's fixture: data, never compiled here. -->
  <ItemGroup>
    <Compile Remove="example\**" />
    <None Remove="example\**" />
  </ItemGroup>

</Project>
